# Frontend (Next.js / Vercel)

# Express backend. Socket.io connects here; /api/* is forwarded to it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ── Admin panel (/admin) ──────────────────────────────────────────────
ADMIN_USERNAME=admin            # optional, defaults to "admin"
ADMIN_PASSWORD=change-me        # no password = admin login disabled
NEXTAUTH_SECRET=                # any long random string: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # your site's URL (Vercel sets this automatically)
ADMIN_API_KEY=                  # long random string, must match the server's ADMIN_API_KEY
